# Copia este archivo a .env y rellena valores reales.
# Nunca versiones el .env con secretos.

# Clave larga y aleatoria (>= 50 caracteres). No uses django-insecure-.
SECRET_KEY=replace-with-a-long-random-value

# False por defecto. Pon True solo en desarrollo local.
DEBUG=False

# Hosts permitidos, separados por comas y sin espacios vacíos.
ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes de confianza para CSRF en producción (https://tu-dominio.com).
CSRF_TRUSTED_ORIGINS=

# True solo si estás detrás de un proxy de confianza que envía X-Forwarded-Proto.
TRUST_PROXY_HEADERS=False

# Caché de los contadores de rate limiting: "default" (memoria) o "shared" (BD).
RATE_LIMIT_CACHE_ALIAS=default

# Caché del rate limit de /get_python_function: "default" (memoria, por worker).
SNIPPET_RATE_LIMIT_CACHE_ALIAS=default

# Exigir TOTP a los usuarios staff en /admin/. Actívalo tras enrolar el dispositivo.
ADMIN_TOTP_REQUIRED=False

# PostgreSQL en producción. Si se deja vacío, se usa SQLite.
DATABASE_URL=

# Ruta alternativa para SQLite (por ejemplo, un disco persistente).
# DB_PATH=/var/data/db.sqlite3
